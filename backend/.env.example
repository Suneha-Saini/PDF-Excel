# ==========================================================
# Fill in the real values below. Leave a value empty to skip
# that integration. Do NOT commit this file.
# ==========================================================

# ---- Core ----
SECRET_KEY=
ENCRYPTION_KEY=
FRONTEND_URL=

# ---- SharePoint / Azure AD ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USERNAME=
AZURE_PASSWORD=
SP_SITE_URL=
SP_LIBRARY_NAME=
SP_BASE_FOLDER=
SP_CREATE_YEAR_FOLDER=
SP_CREATE_MONTH_FOLDER=

# ---- Manager.io (Local server), e.g. http://127.0.0.1:8090 ----
MANAGER_LOCAL_URL=
MANAGER_LOCAL_USERNAME=
MANAGER_LOCAL_SECRET=
MANAGER_LOCAL_BUSINESS_ID=
MANAGER_LOCAL_BANK_ACCOUNT_ID=
MANAGER_LOCAL_SUSPENSE_ACCOUNT_ID=

# ---- Manager.io (Cloud), e.g. https://yourcompany.manager.io ----
MANAGER_CLOUD_URL=
MANAGER_CLOUD_USERNAME=
MANAGER_CLOUD_SECRET=
MANAGER_CLOUD_BUSINESS_ID=
MANAGER_CLOUD_BANK_ACCOUNT_ID=
MANAGER_CLOUD_SUSPENSE_ACCOUNT_ID=

# ---- Xero (create an app at developer.xero.com) ----
# Redirect URI registered in Xero must match XERO_REDIRECT_URI exactly.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Granular scopes (newer Xero apps). If Xero reports invalid_scope, try the older
# broad one instead: offline_access accounting.transactions accounting.settings accounting.contacts
XERO_SCOPES=
XERO_DEFAULT_ACCOUNT_CODE=
XERO_SUSPENSE_CONTACT_NAME=

# ---- QuickBooks Online (create an app at developer.intuit.com) ----
# Redirect URI registered in Intuit Developer must match QUICKBOOKS_REDIRECT_URI exactly.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=
QUICKBOOKS_SCOPES=
QUICKBOOKS_DEFAULT_ACCOUNT_ID=



# ---- Webhooks (Xero / QuickBooks call this app, so they need a public https URL: see INTEGRATIONS.md) ----
# Xero: developer.xero.com/app/manage > your app > Webhooks > Webhook key (appears after you add a delivery URL)
XERO_WEBHOOK_KEY=
# Intuit: developer.intuit.com > Dashboard > your app > Webhooks > Verifier token
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# ---- Auto-sync tuning (optional; these are the defaults) ----
SYNC_ENABLED=
SYNC_NIGHTLY_HOUR=
SYNC_MAX_AGE_HOURS=
SYNC_WEBHOOK_MIN_GAP_SECONDS=
